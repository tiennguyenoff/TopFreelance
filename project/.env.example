# Sao chép thành project/.env (đã .gitignore) rồi điền thông tin thật.
# Khuyến nghị: tạo user MySQL riêng có mật khẩu, chỉ cấp quyền trên topfreelance_db:
#   CREATE USER 'tf_app'@'localhost' IDENTIFIED BY 'mat-khau-manh';
#   GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX ON topfreelance_db.* TO 'tf_app'@'localhost';
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=topfreelance_db
# Mặc định chỉ nghe trên máy này. Đặt TF_HOST=0.0.0.0 nếu thật sự cần mở cho mạng LAN.
TF_HOST=127.0.0.1
# Cổng khi chạy thật (npm start). Dev (npm run dev) dùng cổng của Vite.
PORT=3000

# BẮT BUỘC: khóa ký JWT, >= 32 ký tự ngẫu nhiên. Thiếu thì server từ chối khởi động. Tạo bằng:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Mật khẩu 2 tài khoản demo (server băm scrypt rồi ghi vào MySQL khi khởi động). Tự đặt, đừng commit.
#   Freelancer: alex.freelancer@topfreelance.io   Doanh nghiệp: sarah.enterprise@techcorp.global
DEMO_FREELANCER_PASSWORD=
DEMO_BUSINESS_PASSWORD=
